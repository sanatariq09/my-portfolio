# Google AI Studio: https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Default in code is gemini-2.5-flash (gemini-1.5-* is removed / 404). Override if needed:
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.0-flash

# Optional (default 8787)
# PORT=8787

# Production: comma-separated allowed origins for CORS (omit to allow any)
# FRONTEND_ORIGIN=https://yoursite.com,https://www.yoursite.com
